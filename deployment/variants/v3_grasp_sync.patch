+# =============================================================================
+# Hand-arm grasp synchronization interlock
+# =============================================================================
+
+class GraspSyncInterlock:
+    """
+    Execution-layer synchronization between each physical hand and its arm.
+
+    Important:
+    - πR² inference NEVER stops.
+    - VLM cache update NEVER stops.
+    - DiT streaming NEVER stops.
+    - Hand command is NEVER replaced here.
+    - Existing hand/gripper mapping is NEVER changed.
+    - Only the corresponding arm command is temporarily replaced with
+      the current measured arm pose while the physical hand catches up.
+    """
+
+    def __init__(
+        self,
+        lag_enter_rad,
+        lag_exit_rad,
+        close_delta,
+        release_ticks,
+        hold_timeout_sec,
+    ):
+        if lag_exit_rad >= lag_enter_rad:
+            raise ValueError(
+                "grasp lag exit threshold must be smaller than enter threshold"
+            )
+        if release_ticks < 1:
+            raise ValueError("release_ticks must be >= 1")
+        if hold_timeout_sec <= 0:
+            raise ValueError("hold_timeout_sec must be > 0")
+
+        self.lag_enter_rad = float(lag_enter_rad)
+        self.lag_exit_rad = float(lag_exit_rad)
+        self.close_delta = float(close_delta)
+        self.release_ticks = int(release_ticks)
+        self.hold_timeout_sec = float(hold_timeout_sec)
+
+        self._state = {
+            "left": {
+                "hold": False,
+                "start": None,
+                "release_count": 0,
+            },
+            "right": {
+                "hold": False,
+                "start": None,
+                "release_count": 0,
+            },
+        }
+
+    def _apply_side(
+        self,
+        side,
+        pred_hand4,
+        obs,
+        cmd_arm,
+        now,
+        step,
+    ):
+        physical_hand = np.asarray(
+            obs[f"{side}_hand"],
+            dtype=np.float64,
+        ).reshape(6)
+
+        # Preserve exactly the same hand/gripper representation already
+        # validated by this deployment.
+        current_hand4 = base.compress_hand_6_to_4(physical_hand)
+
+        target_t = hand4_to_gripper_t(pred_hand4)
+        current_t = hand4_to_gripper_t(current_hand4)
+
+        target_hand6 = hand4_gripper_t_to_hand6(
+            pred_hand4,
+            target_t,
+        )
+
+        # Whole-hand lag, including h0/thumb and all projected fingers.
+        hand_lag = float(
+            np.max(np.abs(target_hand6 - physical_hand))
+        )
+
+        # In the existing gripper mapping, larger t means further toward
+        # the commanded closing configuration.
+        closing_gap = float(target_t - current_t)
+
+        st = self._state[side]
+        event = None
+
+        # ------------------------------------------------------------
+        # NORMAL -> GRASP_WAIT
+        # ------------------------------------------------------------
+        if not st["hold"]:
+            if (
+                closing_gap >= self.close_delta
+                and hand_lag >= self.lag_enter_rad
+            ):
+                st["hold"] = True
+                st["start"] = now
+                st["release_count"] = 0
+                event = "ENTER"
+
+        # ------------------------------------------------------------
+        # GRASP_WAIT
+        # ------------------------------------------------------------
+        if st["hold"]:
+            if hand_lag <= self.lag_exit_rad:
+                st["release_count"] += 1
+            else:
+                st["release_count"] = 0
+
+            if st["release_count"] >= self.release_ticks:
+                st["hold"] = False
+                st["start"] = None
+                st["release_count"] = 0
+                event = "EXIT"
+
+            elif (
+                st["start"] is not None
+                and now - st["start"] > self.hold_timeout_sec
+            ):
+                raise RuntimeError(
+                    f"Safety stop: {side} hand failed to catch up "
+                    f"within {self.hold_timeout_sec:.2f}s | "
+                    f"hand_lag={hand_lag:.3f}rad | "
+                    f"target_t={target_t:.3f} "
+                    f"current_t={current_t:.3f}"
+                )
+
+        if event is not None:
+            print(
+                f"[GRASP_SYNC] {side.upper()} {event} | "
+                f"lag={hand_lag:.3f}rad | "
+                f"target_t={target_t:.3f} "
+                f"current_t={current_t:.3f} "
+                f"closing_gap={closing_gap:.3f}",
+                flush=True,
+            )
+
+        # While waiting for the physical hand, keep the arm exactly at
+        # its current measured joint pose. The hand command remains untouched.
+        if st["hold"]:
+            cmd_arm = np.asarray(
+                obs[f"{side}_arm"],
+                dtype=np.float64,
+            ).copy()
+
+        info = {
+            "hold": bool(st["hold"]),
+            "hand_lag": hand_lag,
+            "target_t": float(target_t),
+            "current_t": float(current_t),
+            "closing_gap": closing_gap,
+        }
+
+        return cmd_arm, info
+
+    def apply(
+        self,
+        raw22,
+        obs,
+        cmd_la,
+        cmd_ra,
+        step,
+    ):
+        _, _, pred_lh4, pred_rh4 = split_action22(raw22)
+
+        now = time.monotonic()
+
+        cmd_la, left_info = self._apply_side(
+            "left",
+            pred_lh4,
+            obs,
+            cmd_la,
+            now,
+            step,
+        )
+
+        cmd_ra, right_info = self._apply_side(
+            "right",
+            pred_rh4,
+            obs,
+            cmd_ra,
+            now,
+            step,
+        )
+
+        if (
+            step % 20 == 0
+            and (left_info["hold"] or right_info["hold"])
+        ):
+            print(
+                "[GRASP_SYNC] HOLD | "
+                f"L={int(left_info['hold'])} "
+                f"lag={left_info['hand_lag']:.3f} "
+                f"t={left_info['current_t']:.3f}"
+                f"->{left_info['target_t']:.3f} | "
+                f"R={int(right_info['hold'])} "
+                f"lag={right_info['hand_lag']:.3f} "
+                f"t={right_info['current_t']:.3f}"
+                f"->{right_info['target_t']:.3f}",
+                flush=True,
+            )
+
+        return cmd_la, cmd_ra, {
+            "left": left_info,
+            "right": right_info,
+        }
+
+
