+# =============================================================================
+# Arm command temporal scaling
+# =============================================================================
+
+def temporal_scale_arm(target, previous_command, measured, scale):
+    """
+    Slow only the arm command trajectory.
+
+    scale = 1.0:
+        identical to original V2.
+
+    scale < 1.0:
+        interpolate between the previously issued arm target and the
+        latest safe V2 arm target.
+
+    IMPORTANT:
+    - does NOT modify πR² inference
+    - does NOT modify d
+    - does NOT modify the hand command
+    - does NOT bypass any original safety gate
+    """
+
+    target = np.asarray(target, dtype=np.float64).reshape(7)
+    measured = np.asarray(measured, dtype=np.float64).reshape(7)
+
+    if previous_command is None:
+        previous_command = measured
+    else:
+        previous_command = np.asarray(
+            previous_command,
+            dtype=np.float64,
+        ).reshape(7)
+
+    command = (
+        previous_command
+        + float(scale) * (target - previous_command)
+    )
+
+    return np.ascontiguousarray(command)
+
+
