+# =============================================================================
+# Future-horizon grasp intent guard
+# =============================================================================
+
+class FutureGraspGuard:
+    """
+    Detect an upcoming grasp from several FUTURE hand horizons.
+
+    Future horizons are only used as an intent signal.
+    No future action is ever directly sent.
+
+    State per hand:
+        NORMAL
+          |
+          | repeated monotonic future-t closing trend
+          v
+        PREGRASP_HOLD
+          - corresponding arm held at current measured pose
+          - hand still executes CURRENT clean πR² action
+          |
+          | current clean hand target really starts closing
+          v
+        GRASP_WAIT
+          - arm still held
+          - physical hand catches up
+          |
+          v
+        NORMAL
+    """
+
+    def __init__(self):
+        self.state = {
+            "left": self._new_state(),
+            "right": self._new_state(),
+        }
+
+    @staticmethod
+    def _new_state():
+        return {
+            "active": False,
+            "confirm": 0,
+            "cancel": 0,
+            "closing_started": False,
+            "release_count": 0,
+            "start_time": None,
+            "goal_t": 0.0,
+        }
+
+    @staticmethod
+    def _physical_t(side, obs):
+        hand6 = np.asarray(
+            obs[f"{side}_hand"],
+            dtype=np.float64,
+        ).reshape(6)
+
+        hand4 = base.compress_hand_6_to_4(hand6)
+        return hand4_to_gripper_t(hand4)
+
+    @staticmethod
+    def _current_target_t(side, raw22):
+        _, _, lh4, rh4 = split_action22(raw22)
+        h4 = lh4 if side == "left" else rh4
+        return hand4_to_gripper_t(h4)
+
+    @staticmethod
+    def _future_t_sequence(side, chunk, start_idx):
+        if chunk is None or start_idx is None:
+            return None
+
+        chunk = np.asarray(chunk, dtype=np.float64)
+
+        end_idx = start_idx + PREGRASP_PREVIEW_POINTS
+
+        if (
+            chunk.ndim != 2
+            or chunk.shape[1] != 22
+            or end_idx > len(chunk)
+        ):
+            return None
+
+        hand_slice = (
+            slice(14, 18)
+            if side == "left"
+            else slice(18, 22)
+        )
+
+        seq = []
+
+        for i in range(start_idx, end_idx):
+            h4 = chunk[i, hand_slice]
+            seq.append(hand4_to_gripper_t(h4))
+
+        return np.asarray(seq, dtype=np.float64)
+
+    @staticmethod
+    def _is_closing_trend(seq):
+        if seq is None or len(seq) < PREGRASP_PREVIEW_POINTS:
+            return False
+
+        diffs = np.diff(seq)
+
+        monotonic = bool(
+            np.all(diffs >= PREGRASP_MIN_T_STEP)
+        )
+
+        net = float(seq[-1] - seq[0])
+
+        return bool(
+            monotonic
+            and net >= PREGRASP_MIN_T_NET
+        )
+
+    def _apply_side(
+        self,
+        side,
+        raw22,
+        obs,
+        cmd_arm,
+        chunk,
+        chunk_idx,
+        step,
+        preview_available,
+    ):
+        st = self.state[side]
+
+        current_t = self._physical_t(side, obs)
+        target_t = self._current_target_t(side, raw22)
+
+        seq = None
+        trend = False
+
+        if preview_available:
+            seq = self._future_t_sequence(
+                side,
+                chunk,
+                chunk_idx,
+            )
+            trend = self._is_closing_trend(seq)
+
+        # ----------------------------------------------------
+        # NORMAL: look for repeated future closing trend
+        # ----------------------------------------------------
+        if not st["active"]:
+
+            if trend:
+                st["confirm"] += 1
+            elif preview_available:
+                st["confirm"] = 0
+
+            if st["confirm"] >= PREGRASP_CONFIRM_TICKS:
+                st["active"] = True
+                st["confirm"] = 0
+                st["cancel"] = 0
+                st["closing_started"] = False
+                st["release_count"] = 0
+                st["start_time"] = time.monotonic()
+                st["goal_t"] = current_t
+
+                seq_str = (
+                    np.array2string(
+                        seq,
+                        precision=3,
+                        separator=",",
+                    )
+                    if seq is not None
+                    else "n/a"
+                )
+
+                print(
+                    f"[PREGRASP] {side.upper()} ENTER | "
+                    f"future_t={seq_str} | "
+                    f"current_t={current_t:.3f} "
+                    f"target_t={target_t:.3f}",
+                    flush=True,
+                )
+
+        # ----------------------------------------------------
+        # PREGRASP HOLD / GRASP WAIT
+        # ----------------------------------------------------
+        if st["active"]:
+
+            # Has the CURRENT clean action actually begun
+            # commanding the hand to close?
+            clean_close_gap = float(
+                target_t - current_t
+            )
+
+            if (
+                not st["closing_started"]
+                and clean_close_gap
+                    >= PREGRASP_CURRENT_CLOSE_GAP
+            ):
+                st["closing_started"] = True
+                st["goal_t"] = max(
+                    st["goal_t"],
+                    target_t,
+                )
+                st["cancel"] = 0
+
+                print(
+                    f"[PREGRASP] {side.upper()} "
+                    f"CLOSE_START | "
+                    f"current_t={current_t:.3f} "
+                    f"target_t={target_t:.3f}",
+                    flush=True,
+                )
+
+            # Once real clean grasping begins, keep tracking the
+            # latest clean target. Never use future tail as goal.
+            if st["closing_started"]:
+                st["goal_t"] = max(
+                    st["goal_t"],
+                    target_t,
+                )
+
+                release_threshold = max(
+                    PREGRASP_MIN_RELEASE_T,
+                    st["goal_t"] - PREGRASP_RELEASE_GAP,
+                )
+
+                grasp_closed_enough = bool(
+                    current_t >= release_threshold
+                )
+
+                if grasp_closed_enough:
+                    st["release_count"] += 1
+                else:
+                    st["release_count"] = 0
+
+                if (
+                    st["release_count"]
+                    >= PREGRASP_RELEASE_TICKS
+                ):
+                    print(
+                        f"[PREGRASP] {side.upper()} EXIT_CONTACT | "
+                        f"current_t={current_t:.3f} "
+                        f"goal_t={st['goal_t']:.3f} "
+                        f"release_threshold={release_threshold:.3f}",
+                        flush=True,
+                    )
+
+                    self.state[side] = self._new_state()
+                    return cmd_arm
+
+            # Before a real close command appears, allow a
+            # false-positive future prediction to cancel itself.
+            else:
+                if preview_available:
+                    if trend:
+                        st["cancel"] = 0
+                    else:
+                        st["cancel"] += 1
+
+                if (
+                    st["cancel"]
+                    >= PREGRASP_CANCEL_TICKS
+                ):
+                    print(
+                        f"[PREGRASP] {side.upper()} CANCEL | "
+                        f"future intent disappeared",
+                        flush=True,
+                    )
+
+                    self.state[side] = self._new_state()
+                    return cmd_arm
+
+            # Safety timeout:
+            # do NOT release the arm and continue downward.
+            elapsed = (
+                time.monotonic() - st["start_time"]
+            )
+
+            if elapsed > PREGRASP_TIMEOUT_SEC:
+                raise RuntimeError(
+                    f"Safety stop: {side} pregrasp hold "
+                    f"timeout {elapsed:.2f}s | "
+                    f"closing_started={st['closing_started']} | "
+                    f"current_t={current_t:.3f} "
+                    f"target_t={target_t:.3f} "
+                    f"goal_t={st['goal_t']:.3f}"
+                )
+
+            # ------------------------------------------------
+            # ARM HOLD:
+            # hand command is deliberately untouched.
+            # ------------------------------------------------
+            cmd_arm = np.asarray(
+                obs[f"{side}_arm"],
+                dtype=np.float64,
+            ).copy()
+
+            if step % 10 == 0:
+                print(
+                    f"[PREGRASP] {side.upper()} HOLD | "
+                    f"closing={int(st['closing_started'])} | "
+                    f"current_t={current_t:.3f} "
+                    f"target_t={target_t:.3f} "
+                    f"goal_t={st['goal_t']:.3f}",
+                    flush=True,
+                )
+
+        return cmd_arm
+
+    def apply(
+        self,
+        raw22,
+        obs,
+        cmd_la,
+        cmd_ra,
+        chunk,
+        chunk_idx,
+        step,
+        preview_available=True,
+    ):
+        cmd_la = self._apply_side(
+            "left",
+            raw22,
+            obs,
+            cmd_la,
+            chunk,
+            chunk_idx,
+            step,
+            preview_available,
+        )
+
+        cmd_ra = self._apply_side(
+            "right",
+            raw22,
+            obs,
+            cmd_ra,
+            chunk,
+            chunk_idx,
+            step,
+            preview_available,
+        )
+
+        return cmd_la, cmd_ra
 
 
