+# ============================================================
+# Future-horizon grasp intent detector
+#
+# IMPORTANT:
+# Future actions are ONLY inspected for grasp intent.
+# They are NEVER sent to the robot.
+# Actual commands still come exclusively from πR²'s clean window.
+# ============================================================
+
+# current horizon + next 3 horizons = 4 t values
+PREGRASP_PREVIEW_POINTS = 4
+
+# Each consecutive horizon must move toward closing by at least this much.
+PREGRASP_MIN_T_STEP = 0.015
+
+# Total closing tendency across the preview window.
+PREGRASP_MIN_T_NET = 0.06
+
+# Require the same trend on two consecutive controller evaluations.
+PREGRASP_CONFIRM_TICKS = 2
+
+# Once the clean/current action itself starts requesting closure,
+# regard grasp execution as having actually started.
+PREGRASP_CURRENT_CLOSE_GAP = 0.04
+
+# Physical hand must catch the latest clean grasp target this closely
+# before the arm is released.
+# During real grasping, the object itself can prevent the physical
+# fingers from ever reaching the model's fully-closed target.
+#
+# Therefore do NOT require near-exact target tracking.
+# A grasp may be considered sufficiently closed when:
+#   1. physical t is already substantially closed, and
+#   2. it is within a contact-tolerant distance of the clean target.
+PREGRASP_RELEASE_GAP = 0.15
+PREGRASP_MIN_RELEASE_T = 0.80
+PREGRASP_RELEASE_TICKS = 3
+
+# If future grasp intent disappears before the real close command arrives,
+# cancel a false-positive pre-hold.
+PREGRASP_CANCEL_TICKS = 3
+
+# Never resume downward arm motion merely because of timeout.
+# Timeout -> safety stop.
+PREGRASP_TIMEOUT_SEC = 2.0
 
 
